  function addBot(team){
    for(let i=0;i<300;i++){
      const x=rand(2,24),y=rand(2,24),dist=Math.hypot(x-player.x,y-player.y);
      if(
        free(x,y,.42)&&
        dist>(team==='ally'?1.5:6)&&
        dist<(team==='ally'?5:40)&&
        drones.every(b=>Math.hypot(b.x-x,b.y-y)>1)
      ){
        const hp=team==='enemy'?10+Math.floor((player.wave-1)/2):10;
        drones.push({
          x,y,team,angle:rand(-Math.PI,Math.PI),hp,maxHp:hp,
          phase:rand(0,7),attack:rand(.6,2),turn:0,glow:0,boss:false
        });
        return;
      }
    }
  }

  function spawnWave(){
    player.wave++;
    player.hp=clamp(player.hp+60,0,player.maxHp);
    player.ammo=WEAPONS[player.weapon].ammo;
    player.reload=0;
    player.magazines=player.loadout.map(w=>WEAPONS[w].ammo);
    projectiles=[];
    rings=[];
    drones=[];

    for(let i=0;i<match.allies;i++)addBot('ally');
    for(let i=0;i<Math.min(8,match.enemies+Math.floor((player.wave-1)/3));i++)
      addBot('enemy');

    if(player.wave%10===0){
      addBot('enemy');
      const boss=drones.at(-1);
      if(boss&&boss.team==='enemy'){
        boss.boss=true;
        boss.hp=36+player.wave*4;
        boss.maxHp=boss.hp;
        boss.attack=.4;
      }
    }

    notify(player.wave%10===0?
      'BOSS ROUND '+player.wave:
      'ROUND '+player.wave+'  //  '+drones.filter(d=>d.team==='enemy').length+' OPPONENTS'
    );
    sound(600,.24,'sine',.06,1000);
    updateHud();
  }

